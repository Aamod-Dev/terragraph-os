# =========================
# TerraGraph OS .gitignore
# =========================

# --- Frontend (Node / React / Vite) ---
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# --- Backend (Python / FastAPI) ---
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.log
*.sqlite3

# --- Environment Variables (CRITICAL) ---
# Never commit secrets, API keys, or passwords
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# --- OS & Editor Files ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?